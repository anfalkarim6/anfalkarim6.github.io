---
/*
  Section heading with an architectural detail callout: the bubble names the sheet
  where the full content lives (top: item count, bottom: sheet number).
*/
interface Props {
  title: string;
  href: string;
  sheet: string;
  count?: number;
  countLabel?: string;
  linkLabel: string;
  id: string;
}
const { title, href, sheet, count, countLabel = 'items', linkLabel, id } = Astro.props;
---
<div class="section-head">
  <h2 id={id} class="display">{title}</h2>
  <a class="callout" href={href} aria-label={`${linkLabel}: ${count ?? ''} ${countLabel}, sheet ${sheet}`}>
    <svg viewBox="0 0 64 64" aria-hidden="true">
      <circle cx="32" cy="32" r="30.5"></circle>
      <path d="M1.5 32h61"></path>
      <text x="32" y="19.5" class="c-top">{count ?? '·'}</text>
      <text x="32" y="45" class="c-bot">{sheet}</text>
    </svg>
    <span class="callout-label">{linkLabel}</span>
  </a>
</div>

<style>
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  h2 {
    font-size: var(--step-4);
    line-height: 0.92;
  }
  .callout {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    flex: none;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .callout svg {
    width: 58px;
    height: 58px;
    overflow: visible;
    transition: transform 0.5s var(--ease-expo);
  }
  .callout circle,
  .callout path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    transition: stroke 0.25s var(--ease-out);
  }
  .callout text {
    fill: currentColor;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .c-top {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }
  .c-bot {
    font-family: var(--font-tech);
    font-size: 10.5px;
  }
  .callout-label {
    font-weight: 620;
    color: var(--link);
  }
  .callout:hover svg {
    transform: rotate(-12deg);
  }
  .callout:hover circle,
  .callout:hover path {
    stroke: var(--accent);
  }
  @media (max-width: 599px) {
    .callout-label {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .callout:hover svg {
      transform: none;
    }
  }
</style>
