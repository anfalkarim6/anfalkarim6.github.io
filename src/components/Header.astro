---
import { site } from '../site.config';

interface Props {
  current?: 'home' | 'essays' | 'projects' | 'about' | undefined;
  sheet: { no: string; name: string };
}
const { current, sheet } = Astro.props;
const links = [
  { key: 'essays', label: 'Essays', href: '/essays/' },
  { key: 'projects', label: 'Projects', href: '/projects/' },
  { key: 'about', label: 'About', href: '/about/' },
] as const;
---
<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href="/" aria-label={`${site.name}, home`} aria-current={current === 'home' ? 'page' : undefined}>
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5" />
        <path d="M1.5 20h37" />
        <text x="20" y="12.6">{site.initials[0]}</text>
        <text x="20" y="29.6">{site.initials[1]}</text>
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="sheet tech" aria-label={`Sheet ${sheet.no}, ${sheet.name}`}>
      <span class="sheet-k">Sheet</span>
      <span class="sheet-no">{sheet.no}</span>
    </p>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: var(--frame);
    z-index: var(--z-sticky);
    background: var(--bg);
    border-bottom: 1px solid var(--line-faint);
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    margin-right: auto;
    text-decoration: none;
    font-weight: 720;
    font-stretch: 118%;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .mark {
    width: 34px;
    height: 34px;
    flex: none;
    overflow: visible;
  }
  .mark circle,
  .mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .mark text {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 700;
    font-stretch: 112%;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .brand:hover .mark circle {
    stroke: var(--accent);
  }
  nav ul {
    display: flex;
    gap: clamp(0.25rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.35rem;
    font-size: 0.95rem;
    font-weight: 560;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 9px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  nav a:hover {
    color: var(--text);
  }
  nav a:hover::after {
    transform: scaleX(0.4);
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .sheet {
    display: none;
    margin: 0;
    padding-left: 1.25rem;
    border-left: 1px solid var(--line-faint);
    color: var(--text-3);
    white-space: nowrap;
  }
  .sheet-no {
    margin-left: 0.5em;
    color: var(--text);
  }
  @media (max-width: 420px) {
    .brand-name {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .sheet {
      display: block;
    }
  }
</style>
