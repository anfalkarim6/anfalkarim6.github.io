---
/*
  A photograph printed as a cyanotype (Prussian blue + paper white) that can be
  "developed" into full colour: on hover for pointers, and with a real toggle button for everyone.
*/
import { unsplash, unsplashSrcset } from '../lib/content';

interface Props {
  id: string;
  alt: string;
  credit?: string;
  creditUrl?: string;
  caption?: string;
  ratio?: number; // width / height of the crop
  sizes?: string;
  position?: string;
  eager?: boolean;
  toggle?: boolean;
  class?: string;
}
const {
  id,
  alt,
  credit,
  creditUrl,
  caption,
  ratio = 3 / 2,
  sizes = '100vw',
  position = '50% 50%',
  eager = false,
  toggle = true,
  class: cls,
} = Astro.props;
const w = 1600;
const h = Math.round(w / ratio);
---
<figure class:list={['cyano-fig', cls]}>
  <div class="cyano" style={`--ratio:${ratio}`}>
    <img
      src={unsplash(id, w, h)}
      srcset={unsplashSrcset(id, [480, 800, 1200, 1600, 2200], ratio)}
      sizes={sizes}
      width={w}
      height={h}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={`object-position:${position}`}
    />
    {
      toggle && (
        <button class="develop tech" type="button" aria-pressed="false" hidden>
          <span class="when-off">Show in colour</span>
          <span class="when-on">Show as cyanotype</span>
        </button>
      )
    }
  </div>
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span class="cap">{caption}</span>}
        {credit && (
          <span class="credit tech">
            Photo:{' '}
            {creditUrl ? (
              <a href={creditUrl} rel="noopener" target="_blank">
                {credit}
                <span class="visually-hidden"> on Unsplash (opens in a new tab)</span>
              </a>
            ) : (
              credit
            )}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  function init() {
    document.querySelectorAll<HTMLButtonElement>('.cyano .develop').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        btn.closest('.cyano')?.classList.toggle('developed', on);
      });
    });
  }
  init();
</script>

<style>
  .cyano-fig {
    margin: 0;
  }
  .cyano {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    isolation: isolate;
    background: var(--cy-800);
  }
  .cyano img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.28) brightness(0.92);
    transform: scale(1.001);
    transition:
      filter 0.9s var(--ease-expo),
      transform 1.6s var(--ease-expo);
  }
  /* Screen-blending Prussian blue maps black→blue and white→paper: a true two-tone cyanotype. */
  .cyano::after {
    content: '';
    position: absolute;
    inset: 0;
    background: oklch(0.36 0.12 243);
    mix-blend-mode: screen;
    pointer-events: none;
    transition: opacity 0.9s var(--ease-expo);
  }
  /* brushed coating edge */
  .cyano::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px oklch(0.975 0.01 235 / 0.18);
    transition: opacity 0.9s var(--ease-expo);
  }
  .cyano.developed img {
    filter: none;
  }
  .cyano.developed::after,
  .cyano.developed::before {
    opacity: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .cyano:hover img {
      filter: none;
      transform: scale(1.015);
    }
    .cyano:hover::after,
    .cyano:hover::before {
      opacity: 0;
    }
  }
  .develop {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.45rem 0.75rem;
    border: 1px solid oklch(0.975 0.01 235 / 0.7);
    border-radius: 2px;
    background: oklch(0.22 0.07 242 / 0.82);
    color: var(--cy-50);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out);
  }
  .develop:hover {
    background: var(--cy-950);
  }
  .develop .when-on,
  .develop[aria-pressed='true'] .when-off {
    display: none;
  }
  .develop[aria-pressed='true'] .when-on {
    display: inline;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    margin-top: 0.7rem;
    font-size: var(--step--1);
    color: var(--text-2);
  }
  .cap {
    max-width: 62ch;
  }
  .credit {
    color: var(--text-3);
    text-transform: none;
    letter-spacing: 0;
  }
  .credit a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .cyano img,
    .cyano::after,
    .cyano::before {
      transition-duration: 0.01s;
    }
    .cyano:hover img {
      transform: none;
    }
  }
</style>
