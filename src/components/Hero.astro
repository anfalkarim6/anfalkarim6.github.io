---
import ReadingRoomSection from './drawings/ReadingRoomSection.astro';
import { site } from '../site.config';

interface Props {
  latestHref: string;
  projectHref: string;
}
const { latestHref, projectHref } = Astro.props;
---
<section class="hero" aria-labelledby="hero-name" data-hero>
  <div class="hero-grid wrap">
    <div class="name-block">
      <div class="dim" data-dim aria-hidden="true">
        <span class="dim-line"></span>
        <span class="dim-label tech" data-dim-label>1 : 1</span>
      </div>
      <h1 id="hero-name" class="name display" data-name>
        <span class="name-line">{site.firstName}</span>
        <span class="name-line">{site.lastName}</span>
      </h1>
    </div>

    <div class="intro">
      <p class="statement">{site.statement}</p>
      <p class="whereabouts tech">
        {site.city}, {site.country}<span aria-hidden="true"> · </span><br class="br-sm" />{site.status}
      </p>
      <a class="button" href={latestHref}>
        Read the latest essay
        <svg viewBox="0 0 26 14" aria-hidden="true"><path d="M0 7h24M18 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
    </div>

    <figure class="hero-drawing">
      <ReadingRoomSection mode="live" />
      <figcaption>
        <a href={projectHref} class="tech">
          Section A–A · Reading Room at Bhati Gate · Studio project, 2025
          <span aria-hidden="true">→</span>
        </a>
      </figcaption>
    </figure>
  </div>

  <!-- CAD crosshair: pointer devices only, purely decorative -->
  <div class="xhair" aria-hidden="true" data-xhair>
    <span class="xh-h"></span>
    <span class="xh-v"></span>
    <span class="xh-box"></span>
    <span class="xh-read tech" data-xread>X 0000.0 &nbsp;Y 0000.0</span>
  </div>
</section>

<script>
  const PX_TO_MM = 25.4 / 96;

  function setupDimension(hero: HTMLElement) {
    const name = hero.querySelector<HTMLElement>('[data-name]');
    const dim = hero.querySelector<HTMLElement>('[data-dim]');
    const label = hero.querySelector<HTMLElement>('[data-dim-label]');
    if (!name || !dim || !label) return;
    const lines = [...name.querySelectorAll<HTMLElement>('.name-line')];
    const measure = () => {
      const w = Math.max(...lines.map((l) => l.getBoundingClientRect().width));
      dim.style.setProperty('--w', `${w}px`);
      label.textContent = `${Math.round(w * PX_TO_MM)}`;
    };
    measure();
    new ResizeObserver(measure).observe(name);
    document.fonts?.ready.then(measure);
    // keep measuring while the name stretches open on load
    const t0 = performance.now();
    const tick = (t: number) => {
      measure();
      if (t - t0 < 1600) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function setupCrosshair(hero: HTMLElement) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const x = hero.querySelector<HTMLElement>('[data-xhair]');
    const read = hero.querySelector<HTMLElement>('[data-xread]');
    if (!x || !read || !fine.matches) return;
    let raf = 0;
    let px = 0;
    let py = 0;
    const paint = () => {
      raf = 0;
      x.style.setProperty('--x', `${px}px`);
      x.style.setProperty('--y', `${py}px`);
      const fmt = (n: number) => (n * PX_TO_MM).toFixed(1).padStart(6, '0');
      read.textContent = `X ${fmt(px)}  Y ${fmt(py)}`;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      px = e.clientX - r.left;
      py = e.clientY - r.top;
      x.classList.add('on');
      if (!raf) raf = requestAnimationFrame(paint);
    });
    hero.addEventListener('pointerleave', () => x.classList.remove('on'));
  }

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    setupDimension(hero);
    setupCrosshair(hero);
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'name'
      'drawing'
      'intro';
    gap: clamp(1.75rem, 4vw, 3rem);
  }
  .name-block {
    grid-area: name;
    position: relative;
    z-index: 1;
  }
  .intro {
    grid-area: intro;
    position: relative;
    z-index: 1;
  }
  .hero-drawing {
    grid-area: drawing;
    margin: 0;
  }

  /* --- the name, stretched open from condensed to expanded on load --- */
  .name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--step-5);
    font-weight: 820;
    line-height: 0.84;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .name-line {
    display: block;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .name {
      animation: stretch-open 1.25s var(--ease-expo) 0.1s both;
    }
  }
  @keyframes stretch-open {
    from {
      font-stretch: 62%;
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
    to {
      font-stretch: 125%;
    }
  }

  /* --- live dimension line measuring the name --- */
  .dim {
    --w: 0px;
    position: relative;
    width: var(--w);
    height: 26px;
    margin-bottom: clamp(0.75rem, 1.6vw, 1.25rem);
  }
  .dim-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--line);
  }
  .dim-line::before,
  .dim-line::after {
    content: '';
    position: absolute;
    top: -9px;
    width: 1px;
    height: 19px;
    background: var(--line);
  }
  .dim-line::before {
    left: 0;
  }
  .dim-line::after {
    right: 0;
  }
  /* 45° architectural ticks */
  .dim::before,
  .dim::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--line);
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .dim::before {
    left: 0;
  }
  .dim::after {
    left: 100%;
  }
  .dim-label {
    position: absolute;
    left: 50%;
    top: 50%;
    padding: 0 0.6em;
    background: var(--bg);
    color: var(--text);
    transform: translate(-50%, -54%);
    white-space: nowrap;
  }
  .dim-label::after {
    content: ' mm';
    color: var(--text-3);
  }

  .statement {
    font-size: var(--step-2);
    line-height: 1.18;
    font-weight: 560;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .whereabouts {
    margin-top: 1.25rem;
    color: var(--text-2);
    max-width: 46ch;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.75rem;
  }
  .br-sm {
    display: none;
  }
  .intro .button {
    margin-top: 1.75rem;
  }

  .hero-drawing :global(svg) {
    width: 100%;
    height: auto;
  }
  .hero-drawing figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }
  .hero-drawing figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0;
  }
  .hero-drawing figcaption a:hover {
    color: var(--accent);
  }

  @media (max-width: 559px) {
    .whereabouts span[aria-hidden] {
      display: none;
    }
    .br-sm {
      display: inline;
    }
  }

  @media (min-width: 1000px) {
    .hero {
      min-height: calc(100svh - var(--header-h) - 2 * var(--frame));
      display: flex;
      align-items: center;
    }
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      grid-template-areas: none;
      column-gap: clamp(1rem, 2vw, 2rem);
      row-gap: 0;
      align-items: end;
    }
    .name-block {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: start;
    }
    .intro {
      grid-column: 1 / 6;
      grid-row: 3;
      padding-top: clamp(1.75rem, 5vh, 3.5rem);
      padding-bottom: 0.5rem;
    }
    .hero-drawing {
      grid-column: 5 / 13;
      grid-row: 1 / 4;
      align-self: center;
      margin-right: calc(-0.4 * var(--gutter));
    }
    /* keep the whole cover sheet inside one viewport */
    .hero-drawing :global(svg) {
      max-height: calc(100svh - var(--header-h) - 2 * var(--frame) - 7.5rem);
    }
    .statement {
      max-width: 24ch;
      font-size: clamp(1.5rem, 0.9rem + 1.1vw, 1.95rem);
    }
  }

  /* short laptop screens: tighten the cover so the call to action stays above the fold */
  @media (min-width: 1000px) and (max-height: 760px) {
    .hero {
      padding-block: 2.5rem 1.5rem;
    }
    .intro {
      padding-top: 1.25rem;
    }
    .intro .button {
      margin-top: 1.25rem;
    }
  }

  /* --- crosshair --- */
  .xhair {
    --x: -100px;
    --y: -100px;
    position: absolute;
    inset: 0;
    z-index: var(--z-crosshair);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  .xhair.on {
    opacity: 1;
  }
  .xh-h,
  .xh-v {
    position: absolute;
    background: var(--line-soft);
  }
  .xh-h {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    transform: translateY(var(--y));
  }
  .xh-v {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    transform: translateX(var(--x));
  }
  .xh-box {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    border: 1px solid var(--accent);
    transform: translate(calc(var(--x) - 5.5px), calc(var(--y) - 5.5px));
  }
  .xh-read {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.2rem 0.45rem;
    background: var(--bg-deep);
    color: var(--text-2);
    white-space: pre;
    transform: translate(calc(var(--x) + 14px), calc(var(--y) + 14px));
  }
  .hero {
    cursor: crosshair;
  }
  .hero :is(a, button) {
    cursor: pointer;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .xhair {
      display: none;
    }
    .hero {
      cursor: auto;
    }
  }
</style>
