---
/*
  Section B–B through the courtyard house, Multan (latitude ≈ 30.2° N).
  Noon sun: summer solstice ≈ 83°, winter solstice ≈ 36°.
*/
interface Props {
  mode?: 'live' | 'scroll' | 'static';
  class?: string;
}
const { mode = 'static', class: cls } = Astro.props;
const modeClass = mode === 'live' ? 'is-live' : mode === 'scroll' ? 'on-scroll' : '';
const uid = Math.random().toString(36).slice(2, 8);

const G = 500; // ground line
const R = 230; // roof underside
// sun rays from the south (right), angle in degrees above horizon, landing at x
const ray = (deg: number, x: number, y: number, len: number) => {
  const r = (deg * Math.PI) / 180;
  return `M${(x + Math.cos(r) * len).toFixed(1)} ${(y - Math.sin(r) * len).toFixed(1)} L${x} ${y}`;
};
---
<svg
  class:list={['drawing', modeClass, cls]}
  viewBox="0 0 1000 600"
  role="img"
  aria-label="Section through the courtyard house. A wind catcher on the north roof scoops the breeze down into the bedroom; air crosses the shaded verandah and rises out of the courtyard. The high summer sun at 83 degrees is kept off the verandah by its roof; the low winter sun at 36 degrees reaches deep inside."
>
  <defs>
    <pattern id={`e-${uid}`} width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="12" stroke="currentColor" opacity="0.45"></line>
    </pattern>
    <marker id={`a-${uid}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)"></path>
    </marker>
  </defs>

  <path class="ln cut draw" pathLength="1" d={`M30 ${G} H970`} style="--d:0.1s" />
  <rect class="fade" x="30" y={G + 2} width="940" height="36" fill={`url(#e-${uid})`} style="--d:0.9s" />

  <!-- walls and roofs (cut) -->
  <g class="poche fade" style="--d:0.3s">
    <rect x="100" y={R} width="18" height={G - R} />
    <rect x="882" y={R} width="18" height={G - R} />
    <rect x="100" y={R - 18} width="300" height="18" />
    <rect x="600" y={R - 18} width="300" height="18" />
    <rect x="600" y={R} width="14" height={G - R} />
    <rect x="290" y={R} width="12" height="120" />
    <!-- parapets -->
    <rect x="100" y={R - 52} width="10" height="34" />
    <rect x="890" y={R - 52} width="10" height="34" />
    <!-- wind catcher -->
    <rect x="150" y="150" width="12" height={R - 168} />
    <rect x="248" y="70" width="12" height={R - 88} />
    <rect x="150" y="62" width="110" height="12" />
  </g>
  <!-- verandah (dalaan) beam and column seen beyond -->
  <path class="ln draw" pathLength="1" d={`M398 ${R} V${G} M386 ${R} V${G}`} style="--d:0.6s" />
  <path class="ln thin draw" pathLength="1" d="M156 74 V150 M150 112 H162" style="--d:0.7s" />

  <!-- courtyard: neem tree, pool -->
  <g style="--d:1s;--dur:1.2s">
    <path class="ln draw" pathLength="1" d={`M548 ${G} V376 M548 420 L522 392 M548 404 L574 374`} />
    <ellipse class="ln thin draw" pathLength="1" cx="548" cy="336" rx="50" ry="44" stroke-dasharray="3 4" />
  </g>
  <path class="ln draw" pathLength="1" d={`M440 ${G} V${G - 10} H470 M560 ${G - 10} H590 V${G}`} style="--d:1.1s" />

  <!-- figures -->
  <g style="--d:1.2s">
    <path class="ln draw" pathLength="1" d={`M345 ${G} L345 ${G - 44} M339 ${G} L345 ${G - 44} L351 ${G} M336 ${G - 90} L354 ${G - 90} L355 ${G - 46} L335 ${G - 46} Z`} />
    <circle class="ln draw" pathLength="1" cx="345" cy={G - 102} r="8" />
    <path class="ln draw" pathLength="1" d={`M180 ${G - 34} H260 M188 ${G - 34} V${G} M252 ${G - 34} V${G}`} />
  </g>

  <!-- labels -->
  <g class="fade" style="--d:1.4s">
    <text class="label" x="150" y="300" text-anchor="middle">BED 1</text>
    <text class="label" x="345" y="300" text-anchor="middle">DALAAN</text>
    <text class="label" x="418" y="488" text-anchor="middle">SEHN</text>
    <text class="label" x="750" y="300" text-anchor="middle">BED 2</text>
    <text class="label" x="205" y="52" text-anchor="middle">MANGH</text>
    <text class="label" x="40" y={G - 10}>N</text>
    <text class="label" x="950" y={G - 10}>S</text>
  </g>

  <!-- airflow -->
  <g style="--d:1.6s;--dur:1.6s">
    <path class="ln draw flow" pathLength="1" d="M30 110 C110 112 190 100 206 130 C220 170 214 300 230 360 C250 420 320 430 420 400 C500 372 520 260 530 170 C536 120 560 90 610 70" marker-end={`url(#a-${uid})`} />
  </g>

  <!-- sun angles -->
  <g style="--d:2s;--dur:1.2s">
    <path class="ln draw sun" pathLength="1" d={ray(83, 440, G, 420)} />
    <path class="ln draw sun" pathLength="1" d={ray(36, 190, G, 600)} />
  </g>
  <g class="fade" style="--d:2.4s">
    <path class="ln thin" d={`M${440 + 46} ${G} A46 46 0 0 0 ${440 + 46 * Math.cos((83 * Math.PI) / 180)} ${G - 46 * Math.sin((83 * Math.PI) / 180)}`} />
    <text class="label sun-label" x="452" y={G - 56}>83° SUMMER</text>
    <path class="ln thin" d={`M${190 + 70} ${G} A70 70 0 0 0 ${190 + 70 * Math.cos((36 * Math.PI) / 180)} ${G - 70 * Math.sin((36 * Math.PI) / 180)}`} />
    <text class="label sun-label" x="128" y={G - 64}>36° WINTER</text>
  </g>
</svg>

<style>
  .flow {
    stroke: var(--accent);
    stroke-width: 1.8;
  }
  .sun {
    stroke: var(--accent);
    stroke-width: 1.1;
    stroke-dasharray: 8 6;
  }
  .drawing.is-live .sun,
  .drawing.on-scroll .sun {
    stroke-dasharray: 1;
  }
  .sun-label {
    fill: var(--accent);
    font-size: 12px;
  }
</style>
