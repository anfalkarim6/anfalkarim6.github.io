---
/* Look up a drawing by name, so content files can reference drawings without imports. */
import ReadingRoomSection from './ReadingRoomSection.astro';
import CourtyardPlan from './CourtyardPlan.astro';
import CourtyardSection from './CourtyardSection.astro';
import PavilionAxon from './PavilionAxon.astro';

const drawings = {
  'reading-room-section': ReadingRoomSection,
  'courtyard-plan': CourtyardPlan,
  'courtyard-section': CourtyardSection,
  'pavilion-axon': PavilionAxon,
} as const;
export type DrawingName = keyof typeof drawings;

interface Props {
  name: DrawingName;
  mode?: 'live' | 'scroll' | 'static';
  caption?: string;
  class?: string;
}
const { name, mode = 'scroll', caption, class: cls } = Astro.props;
const Cmp = drawings[name];
---
<figure class:list={['drawing-fig', cls]}>
  <Cmp mode={mode} />
  {caption && <figcaption class="tech">{caption}</figcaption>}
</figure>

<style>
  .drawing-fig {
    margin: 0;
  }
  .drawing-fig :global(svg) {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.85rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line-faint);
    color: var(--text-2);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
