---
import Base from '../layouts/Base.astro';
import Cyanotype from '../components/Cyanotype.astro';
import { site, sheets } from '../site.config';

const tools = ['Hand drafting', 'Measured drawing', 'Card & balsa models', 'Rhino', 'SketchUp', 'Illustrator', 'Photography'];
---
<Base title="About" current="about" sheet={sheets.about} description={site.description}>
  <header class="a-head wrap">
    <h1 class="display">About {site.firstName}</h1>
  </header>

  <section class="intro wrap" aria-label="Introduction">
    <div class="intro-text">
      <p class="big">
        I’m {site.name}, a student from {site.city}, {site.country}, and I’ve been drawing buildings for as long as I can remember.
      </p>
      <p>
        I write these essays to understand how buildings think: why a jaali cools a room, why Kahn hid his windows behind giant circles, why a Gothic wall could turn into glass. I draw my own projects to find out whether I’ve understood. Usually I haven’t, at first.
      </p>
      <p>
        I’m now {site.status.charAt(0).toLowerCase() + site.status.slice(1)}. I’m most interested in climate, light, and how old techniques could solve new problems in cities like mine.
      </p>
      <p class="contact-line">
        <a class="button" href={`mailto:${site.email}`}>
          Write to me
          <svg viewBox="0 0 26 14" aria-hidden="true"><path d="M0 7h24M18 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </a>
        <span class="email-plain">{site.email}</span>
      </p>
    </div>
    <Cyanotype
      id="photo-1503387762-592deb58ef4e"
      alt="An architect's hands working on a drawing with a pencil and a parallel ruler."
      ratio={4 / 5}
      sizes="(min-width: 1000px) 34vw, 100vw"
      credit="Daniel McCullough"
      creditUrl="https://unsplash.com/photos/HtBlQdxfG9k"
      class="intro-img"
    />
  </section>

  <section class="cv wrap" aria-labelledby="cv-title">
    <h2 id="cv-title" class="cv-h display">Schedule</h2>
    <div class="sched">
      <h3>Tools</h3>
      <ul class="tools" role="list">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="sched">
      <h3>Languages</h3>
      <p class="langs">English, Urdu</p>
    </div>
  </section>
</Base>

<style>
  .a-head {
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }
  .a-head h1 {
    font-size: clamp(3rem, 1.4rem + 7.4vw, 6rem);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .intro {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .intro-text {
    max-width: 40rem;
  }
  .intro-text p + p {
    margin-top: 1.1em;
  }
  .intro-text p {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.65;
  }
  .intro-text .big {
    color: var(--text);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem !important;
  }
  .email-plain {
    font-family: var(--font-tech);
    font-size: var(--step--1);
    color: var(--text-3);
  }
  @media (min-width: 1000px) {
    .intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .intro-text {
      grid-column: 1 / 8;
    }
    .intro > :global(.intro-img) {
      grid-column: 9 / 13;
    }
  }

  .cv {
    margin-top: clamp(4.5rem, 9vw, 8rem);
  }
  .cv-h {
    font-size: var(--step-4);
    line-height: 0.92;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .sched {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .sched h3 {
    font-size: var(--step-1);
    font-stretch: 112%;
    font-weight: 720;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--text-2);
  }
  .langs {
    color: var(--text-2);
  }
  @media (min-width: 860px) {
    .sched {
      grid-template-columns: 16rem 1fr;
      gap: 2rem;
    }
  }
</style>
