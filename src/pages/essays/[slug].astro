---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cyanotype from '../../components/Cyanotype.astro';
import Note from '../../components/mdx/Note.astro';
import Figure from '../../components/mdx/Figure.astro';
import Drawing from '../../components/drawings/Drawing.astro';
import { getEssays, formatDate, unsplash, type Essay } from '../../lib/content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const essays = await getEssays();
  // "next" walks back through the archive and wraps to the newest
  return essays.map((essay, i) => ({
    params: { slug: essay.id },
    props: { essay, next: essays[(i + 1) % essays.length] },
  }));
}

interface Props {
  essay: Essay;
  next: Essay;
}
const { essay, next } = Astro.props;
const { Content } = await render(essay);
const d = essay.data;
const b = d.building;
---
<Base
  title={d.title}
  description={d.dek}
  print="whiteprint"
  current="essays"
  sheet={{ no: essay.sheet, name: d.title }}
  image={unsplash(d.cover.id, 1200, 630)}
>
  <div class="ruler" aria-hidden="true"><span class="ruler-fill"></span></div>

  <article class="essay">
    <header class="essay-head wrap">
      <nav class="crumbs tech" aria-label="Breadcrumb">
        <a href="/essays/">Essays</a>
        <span aria-hidden="true">/</span>
        <a href={`/essays/?style=${encodeURIComponent(d.style)}`}>{d.style}</a>
      </nav>
      <h1 class="display">{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <p class="byline">
        <span>By {site.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={d.published.toISOString().slice(0, 10)}>{formatDate(d.published)}</time>
        <span aria-hidden="true">·</span>
        <span>{essay.minutes} min read</span>
      </p>

      <dl class="bdata" aria-label="About the building">
        <div class="bd-name"><dt class="tech">Building</dt><dd>{b.name}</dd></div>
        <div><dt class="tech">Architect</dt><dd>{b.architect}</dd></div>
        <div><dt class="tech">Location</dt><dd>{b.location}</dd></div>
        <div><dt class="tech">Built</dt><dd>{b.yearLabel}</dd></div>
        <div><dt class="tech">Material</dt><dd>{b.material}</dd></div>
        <div class="bd-sheet"><dt class="tech">Sheet</dt><dd class="display">{essay.sheet}</dd></div>
      </dl>
    </header>

    <div class="cover wrap">
      <Cyanotype
        id={d.cover.id}
        alt={d.cover.alt}
        caption={d.cover.caption}
        credit={d.cover.credit}
        creditUrl={d.cover.creditUrl}
        position={d.cover.position}
        ratio={2}
        eager
        sizes="(min-width: 1500px) 1440px, 100vw"
      />
    </div>

    <div class="prose">
      <Content components={{ Note, Figure, Drawing }} />
    </div>
  </article>

  <aside class="next wrap" aria-labelledby="next-label">
    <p id="next-label" class="next-k tech">Next sheet · {next.sheet}</p>
    <a class="next-card" href={`/essays/${next.id}/`}>
      <Cyanotype id={next.data.cover.id} alt="" ratio={16 / 9} toggle={false} position={next.data.cover.position} sizes="(min-width: 900px) 40vw, 100vw" />
      <div class="next-text">
        <p class="next-style">{next.data.style} · {next.data.building.city}, {next.data.building.yearLabel}</p>
        <h2 class="display">{next.data.title}</h2>
        <p class="next-dek">{next.data.dek}</p>
      </div>
    </a>
  </aside>
</Base>

<style>
  /* --- reading progress as a scale rule --- */
  .ruler {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .ruler {
      position: fixed;
      left: var(--frame);
      right: var(--frame);
      top: calc(var(--frame) + var(--header-h));
      z-index: var(--z-sticky);
      display: block;
      height: 7px;
      pointer-events: none;
      background:
        repeating-linear-gradient(90deg, var(--line-soft) 0 1px, transparent 1px 10px) top / 100% 4px no-repeat,
        repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 50px) top / 100% 7px no-repeat;
    }
    .ruler-fill {
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: var(--mark);
      transform-origin: left;
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* --- header --- */
  .essay-head {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    color: var(--text-3);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--link);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .essay-head h1 {
    font-size: var(--step-4);
    line-height: 0.95;
    max-width: 16ch;
  }
  .dek {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.42;
    color: var(--text-2);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    color: var(--text-3);
    font-size: var(--step--1);
  }

  /* building data as a title block */
  .bdata {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0.75rem 0 0;
    border: 1px solid var(--line-soft);
  }
  .bdata > div {
    padding: 0.7rem 0.9rem 0.8rem;
    border-right: 1px solid var(--line-faint);
    border-bottom: 1px solid var(--line-faint);
  }
  .bdata > div:nth-child(2n) {
    border-right: 0;
  }
  .bdata .bd-name {
    grid-column: 1 / -1;
    border-right: 0;
  }
  .bdata .bd-name dd {
    font-weight: 680;
    font-stretch: 106%;
  }
  .bdata > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .bdata dt {
    color: var(--text-3);
    margin-bottom: 0.2rem;
  }
  .bdata dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .bd-sheet dd {
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent);
  }

  @media (min-width: 1000px) {
    .essay-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .essay-head > :not(.bdata) {
      grid-column: 1 / 9;
    }
    .bdata {
      grid-column: 9 / 13;
      grid-row: 1 / 5;
      align-self: end;
      margin: 0;
    }
  }

  .cover {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  @media (max-width: 699px) {
    .cover :global(.cyano) {
      aspect-ratio: 4 / 3;
    }
  }

  /* --- prose: text column + redline margin --- */
  .prose {
    --measure: 66ch;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [text-start] minmax(0, var(--measure))
      [text-end] minmax(0, 0px)
      [margin-end] minmax(var(--gutter), 1fr)
      [full-end];
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--font-text);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.7;
    font-optical-sizing: auto;
  }
  @media (min-width: 1240px) {
    .prose {
      grid-template-columns:
        [full-start] minmax(var(--gutter), 1fr)
        [text-start] minmax(0, var(--measure))
        [text-end] 19rem
        [margin-end] minmax(var(--gutter), 1fr)
        [full-end];
    }
  }
  .prose > :global(*) {
    grid-column: text;
  }
  .prose > :global(.wide) {
    grid-column: text-start / margin-end;
  }
  .prose :global(p) {
    margin-top: 1.2em;
  }
  .prose > :global(p:first-child) {
    margin-top: 0;
    font-size: 1.12em;
    line-height: 1.6;
  }
  .prose :global(h2) {
    margin-top: 2.4em;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: 112%;
    font-weight: 740;
    line-height: 1.1;
  }
  .prose :global(h2 + p) {
    margin-top: 0.75em;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(strong) {
    font-weight: 650;
  }
  .prose :global(a) {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.2em 0 0;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-top: 0.55em;
    padding-left: 0.3em;
  }
  .prose :global(li::marker) {
    color: var(--accent);
    font-family: var(--font-tech);
    font-size: 0.8em;
  }
  .prose :global(blockquote) {
    margin: 2.2em 0 0;
    padding: 1.4em 0 0;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    font-stretch: 104%;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
  }
  .prose > :global(.prose-fig) {
    margin-block: 2.5em 0.5em;
  }
  .prose :global(.prose-fig figcaption) {
    font-family: var(--font-display);
  }

  /* --- next essay --- */
  .next {
    margin-top: clamp(4.5rem, 9vw, 8rem);
  }
  .next-k {
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text-3);
  }
  .next-card {
    display: grid;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .next-style {
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .next-card h2 {
    margin-top: 0.6rem;
    font-size: var(--step-3);
    line-height: 0.98;
  }
  .next-dek {
    margin-top: 0.9rem;
    max-width: 44ch;
    color: var(--text-2);
  }
  .next-card:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  @media (min-width: 900px) {
    .next-card {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }
</style>
