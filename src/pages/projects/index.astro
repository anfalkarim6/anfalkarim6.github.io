---
import Base from '../../layouts/Base.astro';
import Drawing from '../../components/drawings/Drawing.astro';
import { getProjects } from '../../lib/content';
import { sheets } from '../../site.config';

const projects = await getProjects();
---
<Base title="Projects" current="projects" sheet={sheets.projects} description="Design projects by Anfal Karim: a reading room in Lahore's Walled City, a courtyard house for Multan's summer, and a bamboo pavilion.">
  <header class="page-head wrap">
    <h1 class="display">Projects</h1>
    <p class="lede">
      Studio work, independent studies and one thing I actually built. Each one started as a question about light, heat or shade.
    </p>
  </header>

  <ol class="sheets wrap" role="list">
    {
      projects.map((p, i) => (
        <li class:list={['sheet', { flip: i % 2 === 1 }]}>
          <a href={`/projects/${p.id}/`} class="sheet-link" aria-labelledby={`p-${p.id}`}>
            <Drawing name={p.data.drawing} mode="scroll" />
            <div class="sheet-text">
              <p class="tech sheet-no">{p.sheet}</p>
              <h2 id={`p-${p.id}`}>{p.data.title}</h2>
              <p class="sheet-sum">{p.data.summary}</p>
              <dl class="facts">
                <div><dt class="tech">Type</dt><dd>{p.data.kind}</dd></div>
                <div><dt class="tech">Year</dt><dd>{p.data.year}</dd></div>
                <div><dt class="tech">Site</dt><dd>{p.data.site}</dd></div>
              </dl>
              <span class="link-arrow" aria-hidden="true">
                Open the sheet
                <svg viewBox="0 0 26 14"><path d="M0 7h24M18 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .page-head {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }
  .page-head h1 {
    font-size: clamp(3.4rem, 1.6rem + 8.4vw, 6rem);
    line-height: 0.85;
    text-transform: uppercase;
  }
  @media (min-width: 1000px) {
    .page-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: end;
    }
    .page-head h1 {
      grid-column: 1 / 8;
    }
    .page-head .lede {
      grid-column: 8 / 13;
      padding-bottom: 0.4rem;
    }
  }

  .sheets {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    margin-top: clamp(3rem, 7vw, 6rem);
    list-style: none;
  }
  .sheet-link {
    display: grid;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .sheet-link :global(.drawing-fig) {
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 1px solid var(--line-faint);
    background: oklch(0.3 0.098 240.5 / 0.55);
    transition: border-color 0.3s var(--ease-out);
  }
  .sheet-link:hover :global(.drawing-fig) {
    border-color: var(--line-soft);
  }
  .sheet-no {
    color: var(--accent);
  }
  .sheet-text h2 {
    margin-top: 0.6rem;
    font-size: var(--step-3);
    font-stretch: 115%;
    font-weight: 780;
    line-height: 0.98;
  }
  .sheet-link:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .sheet-sum {
    margin-top: 1rem;
    max-width: 40ch;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .facts {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .facts dt {
    color: var(--text-3);
    padding-top: 0.15rem;
  }
  .facts dd {
    margin: 0;
    font-size: 0.95rem;
  }
  @media (min-width: 1000px) {
    .sheet-link {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: center;
    }
    .sheet-link :global(.drawing-fig) {
      grid-column: 1 / 9;
    }
    .sheet-text {
      grid-column: 9 / 13;
    }
    .flip .sheet-link :global(.drawing-fig) {
      grid-column: 5 / 13;
      grid-row: 1;
    }
    .flip .sheet-text {
      grid-column: 1 / 5;
      grid-row: 1;
    }
  }
</style>
