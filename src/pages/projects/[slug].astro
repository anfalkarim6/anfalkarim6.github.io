---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Drawing from '../../components/drawings/Drawing.astro';
import Note from '../../components/mdx/Note.astro';
import Figure from '../../components/mdx/Figure.astro';
import { getProjects, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary} current="projects" sheet={{ no: project.sheet, name: d.title }}>
  <article>
    <header class="p-head wrap">
      <nav class="crumbs tech" aria-label="Breadcrumb">
        <a href="/projects/">Projects</a>
        <span aria-hidden="true">/</span>
        <span>{project.sheet}</span>
      </nav>
      <h1 class="display">{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <div class="p-main wrap">
      <Drawing name={d.drawing} mode="live" caption={d.drawingCaption} class="main-drawing" />
    </div>

    <div class="p-body wrap">
      <dl class="schedule" aria-label="Project data">
        <div><dt class="tech">Type</dt><dd>{d.kind}</dd></div>
        <div><dt class="tech">Year</dt><dd>{d.year}</dd></div>
        <div><dt class="tech">Site</dt><dd>{d.site}</dd></div>
        <div><dt class="tech">Programme</dt><dd>{d.programme}</dd></div>
        <div><dt class="tech">Area</dt><dd>{d.area}</dd></div>
        <div><dt class="tech">Tools</dt><dd>{d.tools.join(', ')}</dd></div>
      </dl>
      <div class="p-prose">
        <Content components={{ Drawing, Note, Figure }} />
      </div>
    </div>
  </article>

  <aside class="p-next wrap" aria-labelledby="pnext">
    <p id="pnext" class="tech next-k">Next sheet · {next.sheet}</p>
    <a href={`/projects/${next.id}/`} class="next-link">
      <span class="next-title display">{next.data.title}</span>
      <svg viewBox="0 0 26 14" aria-hidden="true"><path d="M0 7h24M18 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </a>
  </aside>
</Base>

<style>
  .p-head {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    color: var(--text-3);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--link);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .p-head h1 {
    font-size: var(--step-4);
    line-height: 0.95;
    max-width: 18ch;
  }
  .p-main {
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .p-main :global(.main-drawing) {
    padding: clamp(1rem, 3vw, 3rem);
    border: 1px solid var(--line-soft);
  }

  .p-body {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .schedule {
    margin: 0;
    border-top: 1px solid var(--line-soft);
    align-self: start;
  }
  .schedule > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .schedule dt {
    color: var(--text-3);
    padding-top: 0.15rem;
  }
  .schedule dd {
    margin: 0;
    font-size: 0.95rem;
  }
  .p-prose {
    max-width: 40rem;
    font-family: var(--font-text);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.7;
  }
  .p-prose > :global(:first-child) {
    margin-top: 0;
  }
  .p-prose :global(h2) {
    margin-top: 2.2em;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: 112%;
    font-weight: 740;
    line-height: 1.1;
  }
  .p-prose :global(p) {
    margin-top: 1.1em;
  }
  .p-prose :global(h2 + p) {
    margin-top: 0.7em;
  }
  .p-prose :global(em) {
    font-style: italic;
  }
  .p-prose :global(.drawing-fig),
  .p-prose :global(.prose-fig) {
    margin-block: 2.5em 0.5em;
    font-family: var(--font-display);
  }
  .p-prose :global(.drawing-fig) {
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--line-faint);
  }
  @media (min-width: 1000px) {
    .p-body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .schedule {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--frame) + var(--header-h) + 2rem);
    }
    .p-prose {
      grid-column: 6 / 13;
    }
  }

  .p-next {
    margin-top: clamp(4.5rem, 9vw, 8rem);
  }
  .next-k {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text-3);
  }
  .next-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    color: inherit;
    text-decoration: none;
  }
  .next-title {
    font-size: var(--step-3);
    line-height: 1;
  }
  .next-link svg {
    width: clamp(2rem, 4vw, 3.5rem);
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }
  .next-link:hover svg {
    transform: translateX(8px);
  }
  .next-link:hover .next-title {
    color: var(--accent);
  }
</style>
